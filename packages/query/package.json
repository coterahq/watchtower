{
  "name": "@cotera/watchtower-query",
  "version": "0.1.2",
  "description": "TanStack Query bindings for WatchTower watchables",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coterahq/watchtower.git",
    "directory": "packages/query"
  },
  "homepage": "https://github.com/coterahq/watchtower#readme",
  "bugs": "https://github.com/coterahq/watchtower/issues",
  "sideEffects": false,
  "files": ["src", "!src/**/*.spec.*", "!src/**/*.test.*", "README.md"],
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cotera/watchtower": "workspace:^",
    "@cotera/watchtower-events": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "jotai": "^2.16.2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.68.0",
    "jotai": "^2.16.2",
    "react": "^19.1.0"
  }
}
