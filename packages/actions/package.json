    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "neverthrow": "^8.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.8"
  }
