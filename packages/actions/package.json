{
  "name": "@cotera/watchtower-actions",
  "version": "0.1.2",
  "description": "Context-aware actions for WatchTower: shortcuts, window events, command surfaces",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coterahq/watchtower.git",
    "directory": "packages/actions"
  },
  "homepage": "https://github.com/coterahq/watchtower#readme",
  "bugs": "https://github.com/coterahq/watchtower/issues",
  "sideEffects": false,
  "files": ["src", "!src/**/*.spec.*", "!src/**/*.test.*", "README.md"],
